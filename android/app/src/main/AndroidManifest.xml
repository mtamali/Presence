<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup is deliberately false, against the template's default.
         Android's auto-backup would sync this app's data to the user's Drive,
         but for WebView localStorage that sync is unreliable and, worse, can
         restore a stale snapshot over newer records — a teacher would find
         last month's attendance silently overwriting this week's. An absent
         safety net beats an untrustworthy one; durability comes from the
         explicit backup/restore feature instead. See
         docs/superpowers/specs/2026-10-20-android-capacitor-design.md. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- screenOrientation is portrait-locked: the UI is mobile-first by
             design, and on a narrow screen the timetable shows one day at a
             time through a scrollable day strip. The 5-column grid only
             appears at min-width 48rem, which a phone never reaches in either
             orientation, so landscape buys nothing and costs a reflow
             mid-roll-call. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
